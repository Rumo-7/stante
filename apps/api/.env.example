# Copie para apps/api/.env (que não é versionado) e ajuste.
# Postgres.app, PostgreSQL 17, porta 5433, banco stante_dev
DATABASE_URL="postgresql://ylm@127.0.0.1:5433/stante_dev?schema=public"
PORT=4000
NODE_ENV=development
TZ_NEGOCIO=America/Recife

# Anexos: "disco" (desenvolvimento) ou "s3" (produção: bucket S3-compatível, ex.: Cloudflare R2).
# Em produção o disco do servidor é apagado a cada deploy, então "disco" é recusado.
STORAGE_DRIVER=disco
# S3_ENDPOINT="https://<id-da-conta>.r2.cloudflarestorage.com"
# S3_BUCKET="stante-anexos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION=auto

# Gestor inicial criado pelo seed (npm run db:seed). Escolha uma senha sua.
SEED_ADMIN_NOME="Gestora"
SEED_ADMIN_EMAIL="gestor@stante.local"
SEED_ADMIN_SENHA=""

# Contas de demonstração (inspetor@stante.local e representante@stante.local),
# criadas por: npm run db:seed:demo
SEED_DEMO_SENHA=""

# ---- Sentinela (IA de pareceres) --------------------------------------------
# 1) Crie a chave em https://console.groq.com (menu "API Keys").
# 2) Troque COLE_SUA_CHAVE_AQUI pela chave, mantendo as aspas, e salve.
# 3) Reinicie a API (Ctrl+C e npm run dev:api): a chave só é lida ao iniciar.
# NUNCA compartilhe este arquivo, cole a chave em conversas ou tire print dela.
GROQ_API_KEY="COLE_SUA_CHAVE_AQUI"
# O nome do modelo muda com o tempo: confira a lista atual no console da Groq.
GROQ_MODEL="openai/gpt-oss-120b"
# Nome da unidade que assina os pareceres
# UNIDADE_NOME="VISAT/CEREST Recife"
